#!/bin/sh
# BYD Autos - Waechter, minuetlich.
# Startet den Dienst neu, wenn er laufen soll, aber nicht laeuft oder haengt.
#
# Der Pfad in der letzten Zeile ist ein Platzhalter des Installers; er wird
# bei der Installation durch den bin-Pfad des Plugins ersetzt. Sein Name steht
# hier absichtlich NICHT ausgeschrieben: der Installer ersetzt ihn in der
# ganzen Datei, auch im Kommentar - bis 0.9.8 stand danach an dieser Stelle
# ein Satz, der den fertigen Pfad als "Platzhalter" erklaerte.
#
# Bewusst keine feste Zahl von ".." - gemessen legt LoxBerry die Cron-Datei
# nach <Wurzel>/system/cron/cron.01min/<plugin>, also drei Ebenen unter der
# Wurzel; ein $SELF/../.. landete damit auf <Wurzel>/system.
#
# Gruppe 42 (0.9.29): zuerst der Waechter der Befehlsbruecke (startet sie nur mit dem Haken
# "Befehle ueber MQTT annehmen"), dann der Dienstwaechter; dessen Fehlerausgabe nach cron.err
# (Regeln/03).
BBSH="REPLACELBPBINDIR/befehlsbruecke.sh"
[ -f "$BBSH" ] && /bin/bash "$BBSH" waechter >/dev/null 2>&1
mkdir -p "REPLACELBPLOGDIR" 2>/dev/null
ERR="REPLACELBPLOGDIR/cron.err"
touch "$ERR" 2>/dev/null
# 0.9.31 (Nachzug 01.11.2026, Bauart Renault NG 2.1.23): ist die Fehlerdatei nicht schreibbar, braeche die
# Umlenkung den Befehl ab, BEVOR er startet - bis 0.9.30 kein Lauf und keine Spur. Dann geht die Fehlerausgabe
# nach /dev/null, und der Lauf findet statt.
[ -f "$ERR" ] && [ -w "$ERR" ] || ERR=/dev/null
"REPLACELBPBINDIR/dienst.sh" waechter >/dev/null 2>>"$ERR"
